\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\fancyhead[L]{\small\sffamily\color{xhugray}\xhuheadname}
\fancyhead[R]{\small\sffamily\color{xhugray}\leftmark}
\fancyfoot[C]{\small\thepage}
\newcommand{\xhuheadname}{西华大学 818 工程流体力学}
