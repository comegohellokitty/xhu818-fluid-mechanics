%====================== 封面 / 题目环境 ======================%
% \xhucover{主标题}{副标题}{说明段落}
\newcommand{\xhucover}[3]{%
\begin{titlepage}
\centering
\vspace*{2.2cm}
{\sffamily\bfseries\fontsize{31}{40}\selectfont\color{xhubrand} #1\par}
\vspace{0.5cm}
{\color{xhugold}\rule{0.62\textwidth}{2pt}\par}
\vspace{1.0cm}
{\sffamily\fontsize{17}{24}\selectfont\color{xhulight} #2\par}
\vspace{2.4cm}
\begin{minipage}{0.82\textwidth}
\centering\linespread{1.35}\selectfont #3
\end{minipage}
\vfill
{\sffamily\small\color{xhugray} 西华大学 818 工程流体力学 · 考研复习资料\par}
\vspace{0.5cm}
\end{titlepage}}

% 题目环境：\begin{ti} \item ... \end{ti}   紧凑编号
\newenvironment{ti}{\begin{enumerate}[label=\arabic*.,leftmargin=2.1em,itemsep=4pt,topsep=3pt]}{\end{enumerate}}
% 小问：\begin{xiaowen} \item ... \end{xiaowen}
\newenvironment{xiaowen}{\begin{enumerate}[label=(\arabic*),leftmargin=1.8em,itemsep=2pt,topsep=2pt]}{\end{enumerate}}
% 答案标题
\newcommand{\anstitle}[1]{\par\medskip\noindent{\bfseries\sffamily\color{xhubrand} #1}\par\nobreak\vspace{1pt}\nobreak}

%====================== 试卷专用 ======================%
% 选择题选项：纵向紧凑
% \begin{choices} \item xxx \end{choices}
\newenvironment{choices}{\begin{enumerate}[label=(\Alph*),leftmargin=2.3em,itemsep=0.5pt,topsep=2pt,parsep=0pt]}{\end{enumerate}}
% 四个选项都较短时用两列：\fourchoices{甲}{乙}{丙}{丁}
\newcommand{\fourchoices}[4]{%
  \par\vspace{1pt}\noindent
  \begin{tabularx}{\linewidth}{@{}XX@{}}
  (A)~#1 & (B)~#2\\[1.5pt]
  (C)~#3 & (D)~#4
  \end{tabularx}\par\vspace{2pt}}
% 图示说明：原卷有图而本册用文字准确描述（原卷影印见附录）
\newcommand{\tuyi}[1]{\par\vspace{1pt}\noindent{\footnotesize\color{xhugray}\textbf{〔图示〕}#1}\par\vspace{2pt}}
% 解答：\begin{jie} ... \end{jie}     默认印「解：」
%   证明型例题（如教材例 7.4「试证明……」）用 \begin{jie}[证明] ... \end{jie}
\newenvironment{jie}[1][解]{\par\smallskip\noindent{\bfseries\sffamily\color{xhubrand} #1：}\ignorespaces}{\par\smallskip}
% 答案编号小节（用于真题答案段）
\newcommand{\answ}[1]{\par\medskip\noindent{\bfseries\sffamily\color{xhubrand} #1}\par\nobreak\vspace{1pt}\nobreak}

