%% xhu818.sty —— 西华大学 818 工程流体力学复习资料通用样式
%% 编译：xelatex / latexmk -xelatex  (必须 XeLaTeX)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{xhu818}[2026/10/10 v1.0 XHU818 fluid mechanics pack]

%====================== 页面 ======================%
\RequirePackage[a4paper,left=2.2cm,right=2.2cm,top=2.6cm,bottom=2.2cm,headheight=15pt,headsep=3mm,footskip=8mm]{geometry}

%====================== 数学与符号 ======================%
\RequirePackage{xeCJK}
% 把常用符号区交给中文字体渲染，避免 "Missing character"（lmroman 无 ①②★→ 等）
\xeCJKDeclareCharClass{CJK}{"2460 -> "24FF}   % ① ② ③ …
\xeCJKDeclareCharClass{CJK}{"2190 -> "21FF}   % ← → ↑ ↓
\xeCJKDeclareCharClass{CJK}{"25A0 -> "25FF}   % ■ □ ▲ ★ 等几何图形
\xeCJKDeclareCharClass{CJK}{"2600 -> "26FF}   % 杂项符号
\xeCJKDeclareCharClass{CJK}{"3000 -> "303F}   % 全角标点、〔〕
\xeCJKDeclareCharClass{CJK}{"FF00 -> "FFEF}   % 全角形式（＝ ＋ 等）
\xeCJKDeclareCharClass{CJK}{"2000 -> "206F}   % — – … 等通用标点
\xeCJKDeclareCharClass{CJK}{"2200 -> "22FF}   % ≥ ≤ ≈ ≡ ∈ ∑ 等数学算子
\xeCJKDeclareCharClass{CJK}{"2700 -> "27BF}   % ✓ 等符号
\xeCJKDeclareCharClass{CJK}{"3300 -> "33FF}   % ㎡ ㎥ ㎝ 等 CJK 兼容单位（教材 OCR 里常见）
\RequirePackage{amsmath,amssymb,mathrsfs,bm}
\IfFileExists{esint.sty}{\RequirePackage{esint}}{}
\providecommand{\oiint}{\begingroup\setbox0=\hbox{$\textstyle\iint$}\dp0=0pt\raise\dp0\hbox to\wd0{\hss$\bigcirc$\hss}\box0\endgroup}

%====================== 表格与图 ======================%
\RequirePackage{graphicx}
\RequirePackage{booktabs,array,longtable,tabularx,multirow,makecell}
\RequirePackage{enumitem}
\RequirePackage{caption}
\captionsetup{font=small,labelfont={bf,sf},labelsep=quad}
\RequirePackage{xcolor}

%====================== 配色 ======================%
\definecolor{xhubrand}{HTML}{1F4E79}   % 主色 深蓝
\definecolor{xhulight}{HTML}{2E75B6}   % 亮蓝
\definecolor{xhubg}{HTML}{F2F6FA}      % 浅蓝底
\definecolor{xhugold}{HTML}{B8860B}    % 星标金
\definecolor{xhured}{HTML}{9C2A2A}     % 强调红
\definecolor{xhugreen}{HTML}{1E6B3A}   % 结论绿
\definecolor{xhugray}{HTML}{6B6B6B}    % 次要灰
\definecolor{xhugraybg}{HTML}{F5F5F5}

%====================== 星级重要度 ======================%
\newcommand{\xstar}{\textcolor{xhugold}{$\bigstar$}}
\newcommand{\xstare}{\textcolor{black!22}{$\bigstar$}}
% \xstarfull{3} -> ★★★☆☆
\newcommand{\xstarfull}[1]{%
  \ifcase#1\relax
    \xstare\xstare\xstare\xstare\xstare\or
    \xstar\xstare\xstare\xstare\xstare\or
    \xstar\xstar\xstare\xstare\xstare\or
    \xstar\xstar\xstar\xstare\xstare\or
    \xstar\xstar\xstar\xstar\xstare\or
    \xstar\xstar\xstar\xstar\xstar
  \fi}
% 依据标签：\yiju{2022 年真题第 3 题}
\newcommand{\yiju}[1]{{\footnotesize\color{xhugray}〔依据：#1〕}}
% 难度标签：\nandu{易}/中/难
\newcommand{\nandu}[1]{{\footnotesize\color{xhulight}\textbf{[#1]}}}

%====================== 盒子 ======================%
\RequirePackage{tcolorbox}
\tcbuselibrary{skins,breakable}

% 考点框：\begin{kaodian}{3}{考点名} ... \end{kaodian}   （星数，标题）
\newtcolorbox{kaodian}[2]{%
  enhanced,breakable,colback=xhubg,colframe=xhubrand,boxrule=0.7pt,arc=1.2mm,
  left=5pt,right=5pt,top=4pt,bottom=4pt,
  fonttitle=\bfseries\sffamily,coltitle=white,colbacktitle=xhubrand,
  title={#2\hfill\xstarfull{#1}}}

% 公式盒：\begin{gongshi}{公式含义一句话} 公式 + 适用条件 ... \end{gongshi}
\newtcolorbox{gongshi}[1]{%
  enhanced,breakable,colback=white,colframe=xhulight,boxrule=0.7pt,arc=1mm,
  left=5pt,right=5pt,top=4pt,bottom=4pt,
  fonttitle=\bfseries\sffamily,
  title={#1}}

% 提示/重点/易错/结论
\newtcolorbox{tishi}[1][]{enhanced,breakable,colback=xhugraybg,colframe=black!25,boxrule=0.5pt,arc=1mm,
  left=5pt,right=5pt,top=3pt,bottom=3pt,#1}
\newtcolorbox{yicuo}[1][]{enhanced,breakable,colback=xhured!5,colframe=xhured!70,boxrule=0.6pt,arc=1mm,
  left=5pt,right=5pt,top=3pt,bottom=3pt,title={\bfseries\sffamily 易错点},fonttitle=\color{xhured},#1}
\newtcolorbox{jielun}[1][]{enhanced,breakable,colback=xhugreen!5,colframe=xhugreen!70,boxrule=0.6pt,arc=1mm,
  left=5pt,right=5pt,top=3pt,bottom=3pt,title={\bfseries\sffamily 结论},fonttitle=\color{xhugreen},#1}
% 真题出处框：\begin{zhenti}{2022 年 818 第 3 题}{选择题}
\newtcolorbox{zhenti}[2]{enhanced,breakable,colback=xhugold!6,colframe=xhugold!80,boxrule=0.7pt,arc=1mm,
  left=5pt,right=5pt,top=4pt,bottom=4pt,
  fonttitle=\bfseries\sffamily,coltitle=white,colbacktitle=xhugold!85,
  title={#1\hfill\normalfont\small #2}}
% 书上没有的方法 / 应试技巧
\newtcolorbox{banfa}[1][]{enhanced,breakable,colback=xhulight!4,colframe=xhulight!75,boxrule=0.6pt,arc=1mm,
  left=5pt,right=5pt,top=3pt,bottom=3pt,title={\bfseries\sffamily 书上没有的方法},fonttitle=\color{xhulight},#1}
% 依据框（可放多个出处）
\newtcolorbox{yijubox}[1][]{enhanced,breakable,colback=black!3,colframe=black!30,boxrule=0.5pt,arc=1mm,
  left=5pt,right=5pt,top=3pt,bottom=3pt,title={\bfseries\sffamily 重要度依据},#1}

% 教材例题框：\begin{liti}{4.3}{书 p61--62} 题目… \begin{jie} 解… \end{jie} \end{liti}
% 参数 1 = 教材原编号（如 4.3），参数 2 = 书页码/出处（如 书 p61--62）。
% 注意：tcolorbox 环境同样不能放进 \item，也不能跨 \end{ti}/\end{enumerate}。
\newtcolorbox{liti}[2]{%
  enhanced,breakable,colback=xhugreen!3,colframe=xhugreen!65,boxrule=0.7pt,arc=1mm,
  left=5pt,right=5pt,top=4pt,bottom=4pt,
  fonttitle=\bfseries\sffamily,coltitle=white,colbacktitle=xhugreen!75,
  title={教材例 #1\hfill\normalfont\small #2}}

%====================== 标题格式 ======================%
\RequirePackage{titlesec}
\titleformat{\section}{\normalfont\Large\bfseries\sffamily\color{xhubrand}}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalfont\large\bfseries\sffamily\color{xhubrand!85}}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalfont\normalsize\bfseries\sffamily\color{xhubrand!70}}{\thesubsubsection}{0.5em}{}
\titlespacing*{\section}{0pt}{2.2ex plus .3ex}{1.1ex}
\titlespacing*{\subsection}{0pt}{1.8ex plus .3ex}{0.8ex}

%====================== 列表 ======================%
\setlist{topsep=2pt,itemsep=1pt,parsep=0pt,leftmargin=1.6em}
\setlist[enumerate]{label=\arabic*.}

